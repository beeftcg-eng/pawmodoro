[Desktop Entry]
Type=Application
Name=Pawmodoro
Comment=Notes, recurring checklist, pomodoro timer, and YouTube Music
Exec=__INSTALL_DIR__/run.sh
Icon=__ICON_PATH__
Terminal=false
Categories=Utility;Office;
StartupWMClass=Pawmodoro
Actions=quick-add;

[Desktop Action quick-add]
Name=Add a task
Exec=__INSTALL_DIR__/run.sh --quick-add
